# =============================================================================
# Honeypot evidence shipping, alerting and retention configuration
# =============================================================================
#
# Install it:
#
#     sudo install -m 0640 -o root -g cowrie \
#         /opt/cowrie/share/pkg/deploy/cowrie-logship.env.example \
#         /etc/cowrie-logship.env
#     sudoedit /etc/cowrie-logship.env
#
# Read by:
#     deploy/systemd/cowrie-logship.service      (every 5 min)
#     deploy/systemd/cowrie-healthcheck.service  (every 5 min)
#     ops/quarantine_sync.sh
#     ops/alert_dispatch.sh
#     ops/healthcheck.sh
#     ops/prune_local.sh
#     ops/canary_scan.sh
#
# Precedence: this file is sourced after deploy/versions.env, so anything set
# here overrides the shipped default. Leave a value unset or empty to keep the
# default from versions.env.
#
# This file holds no captured honeypot data, but it does name the evidence
# destination - which tells an attacker where the logs go and what to try to
# destroy. Treat it as sensitive: 0640 root:cowrie.
#
# -----------------------------------------------------------------------------
# EVIDENCE DESTINATION
# -----------------------------------------------------------------------------
# Off-host destination for event logs, session recordings and captured files.
#
# The honeypot must not be able to delete or overwrite evidence it has already
# shipped, so that an operator who compromises the honeypot cannot erase the
# record of their own activity. That requires:
#   * a bucket in a SEPARATE AWS ACCOUNT (strongest), or at minimum a separate
#     KMS key whose policy the honeypot's principal cannot modify;
#   * Object Lock enabled, retention at least as long as your obligation;
#   * versioning enabled;
#   * default encryption SSE-KMS with a customer-managed key;
#   * a bucket policy denying s3:DeleteObject and unencrypted uploads - see
#     deploy/aws/security-groups.md, section 4.
#
# REQUIRED: ops/quarantine_sync.sh refuses to run without it.
EVIDENCE_BUCKET=

# Key prefix, so several sensors share one bucket without colliding.
# Objects land at: s3://<bucket>/<prefix>/<sensor-hostname>/<UTC timestamp>/...
# Default: honeypot
EVIDENCE_PREFIX=honeypot

# -----------------------------------------------------------------------------
# ALERTING
# -----------------------------------------------------------------------------
# HTTPS endpoint that accepts a POST with a JSON body: a Slack or Teams
# incoming webhook, a PagerDuty Events API v2 endpoint, or an internal relay.
#
# Leave empty to disable webhook delivery. Alerts are still appended to
# /var/log/cowrie-alerts.log and the journal, so nothing is lost.
#
# The payload contains NO captured data - no passwords, no command text, no
# uploaded filenames. It carries the rule name, severity, sensor name, UTC
# timestamp and the facts needed to triage. That keeps credentials out of a
# third-party service. Do not add captured content to it.
ALERT_WEBHOOK=

# If your endpoint needs a token, keep it in a file rather than in this
# variable: an environment variable is readable in /proc/<pid>/environ by any
# local user. alert_dispatch.sh reads the file and sends it as Authorization.
ALERT_WEBHOOK_SECRET_FILE=

# -----------------------------------------------------------------------------
# RETENTION AND DISK SAFETY
# -----------------------------------------------------------------------------
# Days of evidence to keep on the honeypot before local pruning. The local copy
# is a shipping buffer, not the archive - the archive is the evidence bucket.
# Keep it short: the honeypot's disk is itself a target, and an attacker who
# fills it stops the honeypot recording.
#
# ops/prune_local.sh only ever deletes files that have already been shipped
# successfully (tracked in the per-run manifest), so lowering this never
# destroys un-shipped evidence.
# Default: 30
RETENTION_DAYS_LOCAL=30

# Local captured-file quarantine size, in MiB, before alerts fire.
#
# Two thresholds because the right response differs:
#   WARN     - prune oldest already-shipped uploads and keep going.
#   CRITICAL - prune aggressively and raise a P1. Worth investigating: a burst
#              of uploads is either a coordinated campaign or someone abusing
#              the honeypot as free storage.
#
# The event record (filename, SHA-256, size, session, timestamp) survives even
# when the bytes are pruned, because the hash is what matters for correlation
# and for checking against threat-intel feeds.
# Defaults: 2048 / 4096
QUARANTINE_WARN_MB=2048
QUARANTINE_CRITICAL_MB=4096

# Largest single captured upload to keep, in MiB; larger ones are recorded and
# dropped. Keep this below the instance's free space and consistent with
# Cowrie's own limits in config/cowrie.cfg ([shell] scp_max_files_per_session).
# Default: 64
QUARANTINE_MAX_FILE_MB=64

# -----------------------------------------------------------------------------
# SENSOR PATHS
# -----------------------------------------------------------------------------
# Cowrie state directory: where var/log/cowrie, var/lib/cowrie/tty and
# var/lib/cowrie/downloads live.
# Default: /opt/cowrie
STATE_DIR=/opt/cowrie

# TCP port the honeypot service listens on. Used by the health check, which
# opens a connection and reads the SSH banner: a wedged Twisted reactor accepts
# the TCP connection but never sends the banner, and that is the failure the
# health check exists to catch.
# Default: 22
HONEYPOT_PORT=22

# Canary values to search for on the host itself. Each one is a unique marker
# that only ever appears inside the emulated filesystem. Finding one anywhere
# else means an attacker escaped the honeypot into the real host filesystem, or
# that a file from the emulated system was copied out. ops/canary_scan.sh greps
# these directories for the values in realism/identity.yaml.
# Default: /etc /home /root /srv /var /usr/local /opt/cowrie/etc
CANARY_DIRS="/etc /home /root /srv /var /usr/local /opt/cowrie/etc"

# Path to the identity manifest, used by canary_scan.sh to learn the canary
# values and by install.sh to generate the honeypot profile.
# Default: /opt/cowrie/share/pkg/realism/identity.yaml
IDENTITY=/opt/cowrie/share/pkg/realism/identity.yaml

# -----------------------------------------------------------------------------
# REHEARSING A SHIP
# -----------------------------------------------------------------------------
# There is deliberately no "dry run" switch: ops/quarantine_sync.sh copies,
# verifies, and only then prunes locally, so a run against a wrong destination
# cannot destroy evidence - it just fails to ship. To rehearse safely, point
# EVIDENCE_BUCKET at a scratch bucket and run it by hand as the service
# account, then confirm the objects and the manifest arrived:
#
#     sudo -u cowrie env EVIDENCE_BUCKET=my-scratch-bucket \
#         /usr/local/sbin/quarantine_sync.sh
#     aws s3 ls --recursive s3://my-scratch-bucket/honeypot/
#
# Do this once after every rebuild, before trusting the pipeline with real
# evidence. The manifest lists the SHA-256 of every captured file, so the
# scratch copy can be verified byte-for-byte against what stayed on the host.
