# =============================================================================
# The single place a version or a deployment-wide default is written down.
# =============================================================================
# Sourced by:  deploy/install.sh
#              deploy/uninstall.sh
#              deploy/rebuild.sh
#              ops/quarantine_sync.sh
#
# `deploy/cowrie-logship.env.example` is sourced AFTER this file, so anything
# an operator sets there overrides the default recorded here. Everything below
# is a plain shell assignment: no `export` is needed, and no secrets belong in
# this file.
#
# A version pin is a claim that the artifact was validated. Change one only
# together with the tests that justify it: docs/11-rollback-and-rebuild.md
# describes the change procedure.
# =============================================================================

# -----------------------------------------------------------------------------
# Cowrie
# -----------------------------------------------------------------------------
# Pinned to a COMMIT, not a tag: tags are mutable, and the overlay in
# overlays/cowrie_realism_overlay refuses to load unless the installed release
# matches the version it was validated against.
COWRIE_VERSION="3.1.0"
COWRIE_COMMIT="6ec36d0d5d4a1a14bc6e6ddadcb7b8f255e0570b"
COWRIE_REPO="https://github.com/cowrie/cowrie"

# -----------------------------------------------------------------------------
# Build tooling
# -----------------------------------------------------------------------------
# PyYAML is used only by realism/build_profile.py to read realism/identity.yaml.
# It is installed into the honeypot virtualenv, but no honeypot code path
# imports it.
PYYAML_VERSION="6.0.3"

# install.sh refuses to run on an interpreter older than this. Cowrie 3.1.0
# requires >= 3.11; Ubuntu 24.04 LTS ships 3.12.
MIN_PYTHON_MAJOR="3"
MIN_PYTHON_MINOR="11"

# -----------------------------------------------------------------------------
# Deployment layout and operational defaults
# -----------------------------------------------------------------------------
# These use ${VAR:-default} rather than a plain assignment, because they are
# also settable in /etc/cowrie-logship.env and that file is DOCUMENTED as
# taking precedence: systemd loads it into the environment before
# ops/quarantine_sync.sh sources this file, so a plain assignment here would
# silently overwrite the operator's setting. The version pins above stay
# unconditional - a pin that an environment variable can move is not a pin.
#
# Absolute path of the honeypot state directory. Everything the service reads
# or writes lives under it, and uninstall.sh deletes exactly this path.
: "${STATE_DIR:=/opt/cowrie}"

# The unprivileged account the honeypot runs as. Never root. If Cowrie is
# compromised, this is the privilege an attacker inherits.
: "${HONEYPOT_USER:=cowrie}"
: "${HONEYPOT_GROUP:=cowrie}"

# The port the honeypot listens on. The service is moved from Cowrie's default
# 2222 to 22: a host answering SSH on both 22 and 2222 is a honeypot that has
# been caught mid-configuration (docs/05-isolation-and-network-boundary.md).
: "${HONEYPOT_PORT:=22}"

# Aggregate size of captured uploads before the health check alerts. WARN asks
# for a prune; CRITICAL is a P1 (a burst of uploads is either a campaign or
# someone using the honeypot as free storage).
: "${QUARANTINE_WARN_MB:=2048}"
: "${QUARANTINE_CRITICAL_MB:=4096}"

# Largest single captured upload to keep, in MiB. Must stay consistent with
# `download_limit_size` in config/cowrie.cfg (64 MiB).
: "${QUARANTINE_MAX_FILE_MB:=64}"

# Days of evidence kept on the honeypot before local pruning. The on-host copy
# is a shipping buffer, not the archive: the archive is the evidence bucket.
: "${RETENTION_DAYS_LOCAL:=30}"

# Prefix under which objects land in the evidence bucket:
#   s3://<bucket>/<prefix>/<sensor-hostname>/<UTC timestamp>/...
: "${EVIDENCE_PREFIX:=honeypot}"

# Where ops/canary_scan.sh looks for canary values that have escaped the
# emulated filesystem, and the manifest those values come from.
: "${CANARY_DIRS:=/etc /home /root /srv /var /usr/local $STATE_DIR/etc}"
: "${IDENTITY:=$STATE_DIR/share/pkg/realism/identity.yaml}"

export STATE_DIR HONEYPOT_USER HONEYPOT_GROUP HONEYPOT_PORT
export QUARANTINE_WARN_MB QUARANTINE_CRITICAL_MB QUARANTINE_MAX_FILE_MB
export RETENTION_DAYS_LOCAL EVIDENCE_PREFIX CANARY_DIRS IDENTITY
