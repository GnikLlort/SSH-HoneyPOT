[Unit]
Description=Cowrie honeypot health check
Documentation=file:/opt/cowrie/DEPLOYMENT.txt
# No dependencies: the check must run even when the honeypot is down, which is
# precisely when it matters.

[Service]
Type=oneshot
User=root
Environment=TZ=UTC
# Operator knobs (QUARANTINE_WARN_MB, QUARANTINE_CRITICAL_MB, HONEYPOT_PORT)
# live in this file; deploy/cowrie-logship.env.example lists healthcheck.sh as
# one of its readers. Optional (`-`) so a host that has not installed the file
# yet still runs the check with the defaults from deploy/versions.env.
EnvironmentFile=-/etc/cowrie-logship.env
ExecStart=/usr/local/sbin/healthcheck.sh
# The check is read-only except for the alert state file it maintains.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=120
